{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/executor/check-request.schema.json",
  "title": "Model check request",
  "description": "Request body (agents.md rule 9) an Executor sends on model-registry.executor.<executor_id>.check.pub after its claim token arrived. Carries no claim token; model-registry derives the Executor from the subject and the team from it.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "maxProperties": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "claim_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": ["task_id", "attempt", "claim_seq"],
      "additionalProperties": false
    }
  },
  "required": ["params", "body"],
  "additionalProperties": false
}

      "then": {
        "properties": {
          "publisher": true,
          "publisher_seq": true,
          "team_id": true,
          "executor_id": true,
          "kind": true,
          "occurred_at": true,
          "task_id": true,
          "attempt": true,
          "claim_seq": true,
          "failure_reason": {
            "type": "string",
            "description": "Machine-readable failure reason. executor_k8s_openhands publishes: image_missing, invalid_flow_revision, missing_required_parameter, llm_configuration_incomplete (retryable false); image_pull_failed, pod_restarted_before_finish, pod_failed (task Pod in phase Failed, or exited without an OpenHands finished), agent_server_failed (OpenHands agent server unreachable or its stream failed), llm_budget_exceeded, openhands_<status> for failed, error, stuck or paused (retryable true).",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"

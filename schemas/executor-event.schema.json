          "team_id": true,
          "executor_id": true,
          "kind": true,
          "occurred_at": true,
          "task_id": true,
          "attempt": true,
          "claim_seq": true
        },
        "required": [
          "publisher",
          "publisher_seq",
          "team_id",
          "executor_id",
          "kind",
          "occurred_at",
          "task_id",
          "attempt",
          "claim_seq"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "failed"
          }
        },
        "required": ["kind"]
